{
  "name": "equilibria-react",
  "version": "0.2.0",
  "description": "React components for the Equilibria Engine \u2014 styled, drop-in chart cards with lifecycle management",
  "type": "module",
  "main": "dist/equilibria-react.cjs",
  "module": "dist/equilibria-react.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/equilibria-react.es.js",
      "require": "./dist/equilibria-react.cjs",
      "types": "./dist/index.d.ts"
    },
    "./dist/style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "equilibria-engine-js": "^1.0.8"
  },
  "devDependencies": {
    "@testing-library/react": "^14.1.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "jsdom": "^22.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.2.2",
    "vite": "^4.4.9",
    "vite-plugin-dts": "^3.5.3",
    "vitest": "^0.34.3"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kinetonomics-Equilibria/equilibria-engine-js.git",
    "directory": "packages/react"
  },
  "author": "Jarryd Bentley",
  "license": "MIT",
  "keywords": [
    "equilibria",
    "react",
    "charts",
    "economics",
    "graphs",
    "d3",
    "interactive"
  ]
}
