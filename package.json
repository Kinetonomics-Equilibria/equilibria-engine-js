{
  "name": "equilibria",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for the Equilibria engine, its React bindings, and the student webapp",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "build": "npm run build --workspace=web",
    "preview": "npm run preview --workspace=web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kinetonomics-Equilibria/equilibria-engine-js.git"
  },
  "license": "MIT"
}
