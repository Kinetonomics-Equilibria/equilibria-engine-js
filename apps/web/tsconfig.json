{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "lib": [
            "ESNext",
            "DOM",
            "DOM.Iterable"
        ],
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx",
        // The engine (packages/engine) is written with "strict": false and is
        // consumed here as TypeScript source, so its files enter this program
        // directly and skipLibCheck does not apply to them. These four flags
        // are relaxed to match the engine's own posture. Everything else strict
        // enables — strictFunctionTypes, strictBindCallApply, noImplicitThis,
        // alwaysStrict, useUnknownInCatchVariables — stays on for app code.
        // Tighten the engine and these can be turned back on one at a time.
        "strict": true,
        "noImplicitAny": false,
        "strictNullChecks": false,
        "strictPropertyInitialization": false,
        "useDefineForClassFields": false,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "noFallthroughCasesInSwitch": true,
        "types": [
            "vite/client"
        ]
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "vite.config.ts"
    ]
}
