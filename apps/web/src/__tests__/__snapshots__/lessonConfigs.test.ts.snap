        },
        {
          "max": 28,
          "min": 12,
          "name": "answerA",
          "presentation": true,
          "round": 0.1,
          "value": 20,
        },
      ],
      "schema": "EconSchema",
    },
    "explainedCalcs": {
      "CS": "0.5 * calcs.Qe * (params.a - calcs.Pe)",
      "Pe": "(params.a + params.c)/2",
      "Qe": "(params.a - params.c)/2",
      "TR": "calcs.Pe * calcs.Qe",
    },
    "explorePrompts": [
      "Raise sellers' costs (c). Which way do the price and the quantity sold go?",
      "Raise a and c by the same amount. What changes, and what stays the same?",
      "Make buyers gain less without touching demand.",
    ],
    "id": "market",
    "name": "A market, its surplus and its revenue",
    "narratedCalcs": [
      {
        "fall": "The price falls",
        "label": "Price",
        "meaning": "Equilibrium price",
        "name": "Pe",
        "precision": 2,
        "rise": "The price rises",
        "tex": "P^*",
        "unit": "$",
      },
      {
        "fall": "Less is bought and sold",
        "label": "Quantity",
        "meaning": "Equilibrium quantity",
        "name": "Qe",
        "rise": "More is bought and sold",
        "tex": "Q^*",
      },
      {
        "fall": "Buyers gain less",
        "label": "Consumer surplus",
        "meaning": "Consumer surplus",
        "name": "CS",
        "precision": 2,
        "rise": "Buyers gain more",
        "tex": "\\\\text{Surplus}",
        "unit": "$",
      },
      {
        "fall": "Sellers earn less",
        "label": "Revenue",
        "meaning": "Total revenue",
        "name": "TR",
        "precision": 2,
        "rise": "Sellers earn more",
        "unit": "$",
      },
    ],
    "panels": [
      {
        "delta": "dPe",
        "headline": "Pe",
        "key": "market",
        "name": "Market",
      },
      {
        "delta": "dCS",
        "headline": "CS",
        "key": "surplus",
        "name": "Consumer surplus",
      },
      {
        "delta": "dTR",
        "headline": "TR",
        "key": "revenue",
        "name": "Revenue",
      },
    ],
    "paramMeanings": {
      "a": "where demand meets the price axis",
      "c": "where supply meets the price axis",
    },
    "paramWords": {
      "a": {
        "about": "Where demand meets the price axis. Higher means buyers want more at every price.",
        "curve": "demand",
        "fall": "Demand decreases",
        "rise": "Demand increases",
      },
      "c": {
        "about": "Where supply meets the price axis. Higher means each unit costs sellers more.",
        "curve": "supply",
        "fall": "Sellers' costs fall",
        "rise": "Sellers' costs rise",
      },
    },
    "questionApparatus": {
      "a": {
        "answer": "answerA",
        "start": "startA",
      },
    },
    "scenarios": [
      {
        "description": "Incomes rise and buyers want more at every price.",
        "id": "demand-shock",
        "label": "Demand shock",
        "params": {
          "a": 26,
        },
      },
      {
        "description": "Production gets dearer, so sellers need more to supply the same quantity.",
        "id": "input-costs",
        "label": "Input costs rise",
        "params": {
          "c": 6,
        },
      },
      {
        "description": "Both at once — the quantity effects work against each other.",
        "id": "both",
        "label": "Boom and cost squeeze",
        "params": {
          "a": 26,
          "c": 6,
        },
      },
      {
        "id": "baseline",
        "label": "Back to baseline",
        "params": {
          "a": 20,
          "c": 2,
        },
      },
    ],
  },
  "title": "A market, and what it does to everything else",
}
`;

exports[`the "ppc" lesson > is the lesson it was before the kit 1`] = `
{
  "asides": {
    "noticeboard": {
      "body": "It toasts six at a time instead of four, so the same staff can turn out half as many toasties again in a morning.",
      "headline": "New sandwich press arrives Friday",
      "name": "Staff noticeboard",
      "note": "A made-up note, for this question",
    },
  },
  "cover": {
    "hook": "A café has five staff, four hours and one espresso machine for the Saturday rush. Every hour spent toasting is an hour not spent making coffee. Follow that trade-off and you can work out what every choice really costs.",
    "picture": "cover",
    "question": "Why does more of one thing mean less of another?",
  },
  "goals": [
    "What a café can make with the staff and time it has",
    "What one more toastie really costs",
    "What the curve assumes, and what moves it",
  ],
  "id": "ppc",
  "label": "Production possibilities",
  "lesson": [
    {
      "part": "What the café can make",
      "picture": "crew",
      "say": "It's Saturday morning at a café. Five staff work from 7 to 11: two baristas, two kitchen hands and a manager. That's 20 hours of work, with one espresso machine and one sandwich press.

Customers want more coffees and toasties than that can make. Having less than people want is the problem every economy faces.",
      "term": {
        "meaning": "Having fewer resources than it would take to make everything people want.",
        "word": "Scarcity",
      },
      "title": "Five staff, four hours",
    },
    {
      "reveal": [
        "ppc",
      ],
      "say": "If all 20 hours went on coffee, the café could make 200 coffees. If they all went on toasties, 100 toasties. Every way of splitting the hours is a point on this curve.

The curve shows the most the café can make of one, for each amount of the other.",
      "set": {
        "C": 10,
        "T": 5,
        "h": 20,
        "k": 2,
      },
      "term": {
        "meaning": "Every combination of two goods an economy can make when it uses all its resources as well as it can.",
        "word": "Production possibility curve (PPC)",
      },
      "title": "The production possibility curve",
    },
    {
      "reveal": [
        "Z",
        "attainable",
      ],
      "say": "Last Saturday started slowly: for an hour, two staff had nothing to do. The café made only 40 toasties and 120 coffees, point Z.

Points inside the curve can be made, but they waste resources. The café could have made more of both.",
      "set": {
        "C": 10,
        "T": 5,
        "h": 20,
        "k": 2,
        "pc": 120,
        "pt": 40,
      },
      "term": {
        "meaning": "Making less than you could with what you have, because resources sit idle or are poorly used.",
        "word": "Inefficient",
      },
      "title": "Inside the curve",
    },
    {
      "say": "With every hour put to good use, the café reaches the curve: say 60 toasties and 160 coffees.

Every point on the curve is efficient. To make more of one thing, the café has to make less of the other.",
      "set": {
        "C": 10,
        "T": 5,
        "h": 20,
        "k": 2,
        "pc": 160,
        "pt": 60,
      },
      "term": {
        "meaning": "Using every resource as well as you can, so you can't make more of one thing without making less of another.",
        "word": "Efficient",
      },
      "title": "On the curve",
    },
    {
      "say": "100 toasties and 160 coffees is outside the curve. With the staff, time and machines it has, the café can't make that much, however hard it works.

Move Z around and watch its label: inside the curve, on it, or outside.",
      "set": {
        "C": 10,
        "T": 5,
        "h": 20,
        "k": 2,
        "pc": 160,
        "pt": 100,
      },
      "term": {
        "meaning": "More than the resources can make: any point outside the curve.",
        "word": "Unattainable",
      },
      "title": "Outside the curve",
      "try": [
        {
          "label": "Toasties at Z",
          "param": "pt",
        },
        {
          "label": "Coffees at Z",
          "param": "pc",
        },
      ],
    },
    {
      "part": "What each choice costs",
      "reveal": [
        "A",
        "B",
      ],
      "say": "Start at A: 60 toasties and 160 coffees. Now move to B: 80 toasties and 120 coffees.

The café gains 20 toasties, but gives up 40 coffees to make them. Those 40 coffees are the opportunity cost of the extra toasties.",
      "set": {
        "C": 10,
        "T": 5,
        "a": 60,
        "b": 80,
        "h": 20,
        "k": 2,
      },
      "term": {
        "meaning": "The next best thing you give up when you make a choice.",
        "word": "Opportunity cost",
      },
      "title": "Twenty more toasties",
    },
    {
      "say": "40 coffees for 20 toasties is 2 coffees for each extra toastie: 40 ÷ 20 = 2. That's the opportunity cost per unit.

Drag A or B along the curve, and watch what each extra toastie costs.",
      "term": {
        "meaning": "What you give up for each extra unit you gain: what you give up ÷ what you gain.",
        "word": "Opportunity cost per unit",
      },
      "title": "The cost of one toastie",
      "try": [
        {
          "label": "Toasties at A",
          "param": "a",
        },
        {
          "label": "Toasties at B",
          "param": "b",
        },
      ],
    },
    {
      "say": "From no toasties to 20, the café gives up just 4 coffees: 0.2 coffees a toastie.

The first toasties are made by the kitchen hands, who are slow at coffee anyway, so the café loses very little coffee to make them.",
      "set": {
        "a": 0,
        "b": 20,
      },
      "title": "The first toasties are cheap",
    },
    {
      "say": "From 80 toasties to 100, the café gives up 120 coffees: 6 coffees a toastie.

The last toasties have to be made by the baristas. They make coffee fast and toasties slowly, so every hour they spend toasting costs a lot of coffee.",
      "set": {
        "a": 80,
        "b": 100,
      },
      "term": {
        "meaning": "Each extra unit of one good costs more of the other than the one before. It's why the PPC bows outward.",
        "word": "Increasing opportunity cost",
      },
      "title": "The last toasties are dear",
    },
    {
      "say": "Now suppose every worker could make 10 coffees or 5 toasties an hour. The curve becomes a straight line.

Then every toastie costs 2 coffees, wherever the café is on the curve: even from 80 toasties to 100.",
      "set": {
        "k": 1,
      },
      "term": {
        "meaning": "Every extra unit costs the same amount of the other good, and the PPC is a straight line.",
        "word": "Constant opportunity cost",
      },
      "title": "If everyone were equally good",
      "try": [
        {
          "label": "Specialisation",
          "param": "k",
        },
      ],
    },
    {
      "part": "What the curve assumes",
      "say": "Real cafés are messier than this curve. To draw it, economists make assumptions: things the curve takes as given.

The first: the café makes just two things. It sells muffins and juice too, but two goods fit on two axes, and the trade-off between them is the same.",
      "set": {
        "C": 10,
        "T": 5,
        "a": 60,
        "b": 80,
        "h": 20,
        "k": 2,
      },
      "term": {
        "meaning": "Something a model takes as given, to keep it simple enough to draw and reason with.",
        "word": "Assumption",
      },
      "title": "Every model simplifies",
    },
    {
      "reveal": [
        "coffeeEnd",
        "toastieEnd",
      ],
      "say": "The curve is for one Saturday morning: five staff for four hours, one espresso machine, one sandwich press. It assumes those resources stay fixed.

Say the café opens an hour earlier. That's 25 hours of work, and the whole curve shifts outward: up to 250 coffees or 125 toasties.",
      "set": {
        "C": 10,
        "T": 5,
        "h": 25,
        "k": 2,
      },
      "term": {
        "meaning": "An increase in what an economy can make, shown as the PPC shifting outward.",
        "word": "Economic growth",
      },
      "title": "Fixed resources",
      "try": [
        {
          "label": "Work hours",
          "param": "h",
        },
      ],
    },
    {
      "say": "The curve also assumes the café's machines and know-how stay the same. Say it buys a faster espresso machine: 15 coffees an hour instead of 10.

Now it can make up to 300 coffees, but still only 100 toasties, so the curve pivots up the coffee axis. A and B move up: same toasties, more coffees.",
      "set": {
        "C": 15,
        "T": 5,
        "h": 20,
        "k": 2,
      },
      "term": {
        "meaning": "The machines and know-how used to make things. Better technology gets more out of the same resources.",
        "word": "Technology",
      },
      "title": "Fixed technology",
      "try": [
        {
          "label": "Coffees an hour",
          "param": "C",
        },
      ],
    },
    {
      "say": "Every point on the curve assumes all the café's resources are working, and working well. Real cafés have slow patches, with staff standing around.

Then the café makes less than it could, like Z: inside the curve, with nothing gained in return.",
      "set": {
        "C": 10,
        "T": 5,
        "h": 20,
        "k": 2,
        "pc": 80,
        "pt": 30,
      },
      "term": {
        "meaning": "When every resource that could be working is working.",
        "word": "Full employment",
      },
      "title": "Full employment",
    },
    {
      "say": "The last assumption gives the curve its shape. Resources aren't equally good at everything: the baristas make coffee fast and toasties slowly.

That's why each extra toastie costs more coffees than the last, and why the curve bows outward.",
      "title": "Resources suit different jobs",
    },
    {
      "aside": "noticeboard",
      "ask": {
