                    "ghost": {
                      "label": "_0",
                      "show": "not(params.asking)",
                    },
                    "label": {
                      "text": "D",
                      "x": "min(params.a, 20) - 2",
                    },
                    "name": "demand_market",
                    "slope": -1,
                    "srTitle": "Demand",
                    "title": "demand",
                    "yIntercept": "params.a",
                  },
                  "type": "Line",
                },
                {
                  "def": {
                    "color": "colors.demand",
                    "lineStyle": "dashed",
                    "name": "questionStart",
                    "show": "params.asking",
                    "slope": -1,
                    "strokeOpacity": 0.35,
                    "yIntercept": "params.startA",
                  },
                  "type": "Line",
                },
                {
                  "def": {
                    "color": "colors.demand",
                    "label": {
                      "text": "D_1",
                      "x": "min(params.answerA, 20) - 2",
