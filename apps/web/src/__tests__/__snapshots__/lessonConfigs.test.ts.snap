                    "lineStyle": "dotted",
                    "name": "questionAnswer",
                    "show": "params.revealed",
                    "slope": -1,
                    "yIntercept": "params.answerA",
                  },
                  "type": "Line",
                },
                {
                  "def": {
                    "color": "colors.supply",
                    "label": {
                      "text": "S",
                      "x": "calcs.Pe > 16 ? 1.5 : 18 - params.c",
