        "pt": 30,
      },
      "title": "Over to you",
    },
  ],
  "model": {
    "diagram": {
      "calcs": {
        "cA": "round(calcs.maxC * max(0, 1 - (calcs.tA / calcs.maxT)^params.k)^(1 / params.k))",
        "cB": "round(calcs.maxC * max(0, 1 - (calcs.tB / calcs.maxT)^params.k)^(1 / params.k))",
        "cost": "((params.step >= 6 and params.step < 16) or params.step >= 20) ? calcs.cA - calcs.cB : NaN",
        "dOc": "calcs.oc - prev.calcs.oc",
        "gain": "((params.step >= 6 and params.step < 16) or params.step >= 20) ? calcs.tB - calcs.tA : NaN",
        "maxC": "params.C * params.h",
        "maxT": "params.T * params.h",
        "oc": "round(calcs.cost / calcs.gain, 1)",
        "rZ": "((params.pt / calcs.maxT)^params.k + (params.pc / calcs.maxC)^params.k)^(1 / params.k)",
        "tA": "min(params.a, calcs.maxT)",
        "tB": "min(params.b, calcs.maxT)",
      },
      "layout": {
        "CustomLayout": {
          "panels": [
            {
              "key": "cafe",
              "objects": [
                {
                  "def": {
                    "color": "colors.ppf",
                    "fn1": "calcs.maxC * max(0, 1 - ((x) / calcs.maxT)^params.k)^(1 / params.k)",
                    "fn2": "0",
                    "max": "calcs.maxT",
                    "min": 0,
                    "name": "attainable",
                    "opacity": 0.08,
                    "samplePoints": 80,
                    "srTitle": "What the café can make",
                    "title": "",
                  },
                  "type": "Area",
                },
                {
                  "def": {
                    "color": "colors.ppf",
                    "lineStyle": "dashed",
                    "max": 1.5707963267948966,
                    "min": 0,
                    "name": "questionStart",
                    "samplePoints": 80,
                    "show": "params.asking",
                    "strokeOpacity": 0.35,
                    "xFn": "params.startT * params.startH * max(0, cos((t)))^(2 / params.k)",
                    "yFn": "params.startC * params.startH * max(0, sin((t)))^(2 / params.k)",
                  },
                  "type": "Curve",
                },
                {
                  "def": {
                    "color": "colors.ppf",
                    "label": {
                      "position": "bl",
                      "t": 1.35,
                      "text": "\\\\text{PPC}_1",
                    },
                    "lineStyle": "dotted",
                    "max": 1.5707963267948966,
                    "min": 0,
                    "name": "questionAnswer",
                    "samplePoints": 80,
                    "show": "params.revealed and (params.answerH != params.startH or params.answerC != params.startC or params.answerT != params.startT)",
                    "xFn": "params.answerT * params.answerH * max(0, cos((t)))^(2 / params.k)",
                    "yFn": "params.answerC * params.answerH * max(0, sin((t)))^(2 / params.k)",
                  },
                  "type": "Curve",
                },
                {
                  "def": {
                    "color": "colors.ppf",
                    "drag": [
                      {
                        "directions": "xy",
                        "draggable": "(params.step < 6 or params.step >= 12) and not(params.submitted)",
                        "expression": "((max(drag.x, 0) / params.T)^params.k + (max(drag.y, 0) / params.C)^params.k)^(1 / params.k)",
                        "param": "h",
                      },
                    ],
                    "ghost": {
                      "label": "_0",
                      "show": "not(params.asking)",
                    },
                    "label": {
                      "position": "bl",
                      "show": "params.step < 6 or params.step >= 12",
                      "t": 1.35,
                      "text": "\\\\text{PPC}",
                    },
                    "max": 1.5707963267948966,
                    "min": 0,
                    "name": "ppc",
                    "samplePoints": 80,
                    "srTitle": "Production possibility curve",
                    "title": "",
                    "xFn": "calcs.maxT * max(0, cos((t)))^(2 / params.k)",
                    "yFn": "calcs.maxC * max(0, sin((t)))^(2 / params.k)",
                  },
                  "type": "Curve",
                },
                {
                  "def": {
                    "color": "colors.ppf",
                    "drag": [
                      {
                        "directions": "y",
                        "draggable": "not(params.submitted)",
                        "expression": "max(drag.y, 0) / params.h",
                        "param": "C",
                      },
                    ],
                    "name": "coffeeEnd",
                    "r": 6,
                    "srTitle": "Most coffees",
                    "title": "",
                    "x": 0,
                    "y": "calcs.maxC",
                  },
                  "type": "Point",
                },
                {
                  "def": {
                    "color": "colors.ppf",
                    "drag": [
                      {
                        "directions": "x",
                        "draggable": "not(params.submitted)",
                        "expression": "max(drag.x, 0) / params.h",
                        "param": "T",
                      },
                    ],
                    "name": "toastieEnd",
                    "r": 6,
                    "srTitle": "Most toasties",
                    "title": "",
                    "x": "calcs.maxT",
                    "y": 0,
                  },
                  "type": "Point",
                },
                {
                  "def": {
                    "a": [
                      "calcs.tA",
                      "calcs.cA",
                    ],
                    "b": [
                      "calcs.tB",
                      "calcs.cA",
                    ],
                    "color": "colors.choice",
                    "lineStyle": "dotted",
                    "name": "gainLeg",
                    "show": "((params.step >= 6 and params.step < 16) or params.step >= 20) and calcs.gain != 0",
                    "title": "",
                  },
                  "type": "Segment",
                },
                {
                  "def": {
                    "a": [
                      "calcs.tB",
                      "calcs.cA",
                    ],
                    "b": [
                      "calcs.tB",
                      "calcs.cB",
                    ],
                    "color": "colors.choice",
                    "lineStyle": "dotted",
                    "name": "costLeg",
                    "show": "((params.step >= 6 and params.step < 16) or params.step >= 20) and calcs.cost != 0",
                    "title": "",
                  },
                  "type": "Segment",
                },
                {
                  "def": {
                    "align": "left",
                    "color": "colors.choice",
                    "flipToFit": true,
                    "name": "gainRight",
                    "plainText": true,
                    "show": "((params.step >= 6 and params.step < 16) or params.step >= 20) and calcs.gain > 0",
                    "text": "concat(\\"+\\", string(calcs.gain), \\" toasties\\")",
                    "title": "",
                    "x": "calcs.tA",
                    "xPixelOffset": 10,
                    "y": "calcs.cA",
                    "yPixelOffset": 13,
                  },
                  "type": "Label",
                },
                {
                  "def": {
                    "color": "colors.choice",
                    "flipToFit": true,
                    "name": "costRight",
                    "plainText": true,
                    "position": "l",
                    "show": "((params.step >= 6 and params.step < 16) or params.step >= 20) and calcs.gain > 0",
                    "text": "concat(\\"−\\", concat(string(calcs.cost), calcs.cost == 1 ? \\" coffee\\" : \\" coffees\\"))",
                    "title": "",
                    "x": "calcs.tB",
                    "y": "(calcs.cA + calcs.cB) / 2",
                  },
                  "type": "Label",
                },
                {
                  "def": {
                    "align": "right",
                    "color": "colors.choice",
                    "flipToFit": true,
                    "name": "gainLeft",
                    "plainText": true,
                    "show": "((params.step >= 6 and params.step < 16) or params.step >= 20) and calcs.gain < 0",
                    "text": "concat(\\"−\\", string(-calcs.gain), \\" toasties\\")",
                    "title": "",
                    "x": "calcs.tA",
                    "xPixelOffset": -10,
                    "y": "calcs.cA",
                    "yPixelOffset": -15,
                  },
                  "type": "Label",
                },
                {
                  "def": {
                    "color": "colors.choice",
                    "flipToFit": true,
                    "name": "costLeft",
                    "plainText": true,
                    "position": "r",
                    "show": "((params.step >= 6 and params.step < 16) or params.step >= 20) and calcs.gain < 0",
                    "text": "concat(\\"+\\", concat(string(-calcs.cost), -calcs.cost == 1 ? \\" coffee\\" : \\" coffees\\"))",
                    "title": "",
                    "x": "calcs.tB",
                    "y": "(calcs.cA + calcs.cB) / 2",
                  },
                  "type": "Label",
                },
                {
                  "def": {
                    "align": "right",
                    "color": "colors.choice",
                    "name": "route",
                    "plainText": true,
                    "show": "((params.step >= 6 and params.step < 16) or params.step >= 20) and true",
                    "text": "concat(\\"A (\\", string(calcs.tA), \\", \\", string(calcs.cA), \\")\\", \\" → \\", \\"B (\\", string(calcs.tB), \\", \\", string(calcs.cB), \\")\\")",
                    "title": "",
                    "x": 158,
                    "xPixelOffset": -5,
                    "y": 320,
                    "yPixelOffset": -12,
                  },
                  "type": "Label",
                },
                {
                  "def": {
                    "align": "right",
                    "color": "colors.choice",
                    "name": "perToastie",
                    "plainText": true,
                    "show": "((params.step >= 6 and params.step < 16) or params.step >= 20) and calcs.gain > 0",
                    "text": "concat(\\"1 more toastie costs \\", format(calcs.oc, {notation: \\"fixed\\", precision: 1}), \\" coffees\\")",
                    "title": "",
                    "x": 158,
                    "xPixelOffset": -5,
                    "y": 320,
                    "yPixelOffset": -36,
                  },
                  "type": "Label",
                },
                {
                  "def": {
                    "align": "right",
                    "color": "colors.choice",
                    "name": "perCoffee",
                    "plainText": true,
                    "show": "((params.step >= 6 and params.step < 16) or params.step >= 20) and calcs.gain < 0 and calcs.cost < 0",
                    "text": "concat(\\"1 more coffee costs \\", format(calcs.gain / calcs.cost, {notation: \\"fixed\\", precision: 1}), \\" toasties\\")",
                    "title": "",
                    "x": 158,
                    "xPixelOffset": -5,
                    "y": 320,
                    "yPixelOffset": -36,
                  },
                  "type": "Label",
                },
                {
                  "def": {
                    "color": "colors.choice",
                    "drag": [
                      {
                        "directions": "xy",
                        "expression": "calcs.maxT * (max(drag.x, 0)^params.k / (max(drag.x, 0)^params.k + (max(drag.y, 0) * calcs.maxT / calcs.maxC)^params.k + 0.000001))^(1 / params.k)",
                        "param": "a",
                      },
                    ],
                    "name": "A",
                    "show": "(params.step >= 6 and params.step < 16) or params.step >= 20",
                    "srTitle": "Point A",
                    "title": "A",
                    "x": "min(params.a, calcs.maxT)",
                    "y": "calcs.cA",
                  },
                  "type": "Point",
                },
                {
                  "def": {
                    "color": "colors.choice",
                    "drag": [
                      {
                        "directions": "xy",
                        "expression": "calcs.maxT * (max(drag.x, 0)^params.k / (max(drag.x, 0)^params.k + (max(drag.y, 0) * calcs.maxT / calcs.maxC)^params.k + 0.000001))^(1 / params.k)",
                        "param": "b",
                      },
                    ],
                    "name": "B",
                    "show": "(params.step >= 6 and params.step < 16) or params.step >= 20",
                    "srTitle": "Point B",
                    "title": "B",
                    "x": "min(params.b, calcs.maxT)",
                    "y": "calcs.cB",
                  },
                  "type": "Point",
                },
                {
                  "def": {
                    "align": "center",
                    "color": "colors.choice",
                    "name": "AIn",
                    "plainText": true,
                    "show": "((params.step >= 6 and params.step < 16) or params.step >= 20) and calcs.gain >= 0",
                    "text": "A",
                    "title": "",
                    "x": "max(0.9166666666666666 * calcs.tA, 8)",
                    "y": "max(0.9166666666666666 * calcs.cA, 16)",
                  },
                  "type": "Label",
                },
                {
                  "def": {
                    "align": "center",
                    "color": "colors.choice",
                    "name": "AOut",
                    "plainText": true,
                    "show": "((params.step >= 6 and params.step < 16) or params.step >= 20) and calcs.gain < 0",
                    "text": "A",
                    "title": "",
                    "x": "max(1.0833333333333333 * calcs.tA, 8)",
                    "y": "max(1.0833333333333333 * calcs.cA, 16)",
                  },
                  "type": "Label",
                },
                {
                  "def": {
                    "align": "center",
                    "color": "colors.choice",
                    "name": "BIn",
                    "plainText": true,
                    "show": "((params.step >= 6 and params.step < 16) or params.step >= 20) and calcs.gain > 0",
                    "text": "B",
                    "title": "",
                    "x": "max(0.9166666666666666 * calcs.tB, 8)",
                    "y": "max(0.9166666666666666 * calcs.cB, 16)",
                  },
                  "type": "Label",
                },
                {
                  "def": {
                    "align": "center",
                    "color": "colors.choice",
                    "name": "BOut",
                    "plainText": true,
                    "show": "((params.step >= 6 and params.step < 16) or params.step >= 20) and calcs.gain <= 0",
                    "text": "B",
                    "title": "",
                    "x": "max(1.0833333333333333 * calcs.tB, 8)",
                    "y": "max(1.0833333333333333 * calcs.cB, 16)",
                  },
                  "type": "Label",
                },
                {
                  "def": {
                    "color": "colors.combination",
                    "drag": [
                      {
                        "directions": "xy",
                        "expression": "params.pt + drag.dx",
                        "param": "pt",
                      },
                      {
                        "directions": "xy",
                        "expression": "params.pc + drag.dy",
                        "param": "pc",
                      },
                    ],
                    "label": {
                      "flipToFit": true,
                      "plainText": true,
                      "text": "concat(\\"Z · \\", calcs.rZ < 0.97 ? \\"inefficient\\" : (calcs.rZ > 1.03 ? \\"unattainable\\" : \\"efficient\\"))",
                    },
                    "name": "Z",
                    "show": "params.step < 6 or params.step == 14 or params.step >= 20",
                    "srTitle": "Point Z",
                    "title": "Z",
                    "x": "params.pt",
                    "y": "params.pc",
                  },
                  "type": "Point",
                },
              ],
              "xAxis": {
                "max": 160,
                "min": 0,
                "title": "Toasties",
              },
              "yAxis": {
                "max": 320,
                "min": 0,
                "title": "Coffees",
              },
            },
          ],
        },
      },
      "params": [
