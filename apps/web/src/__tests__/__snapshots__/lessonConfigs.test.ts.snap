                    "name": "supply_revenue",
                    "slope": 1,
                    "srTitle": "Supply",
                    "title": "supply",
                    "yIntercept": "params.c",
                  },
                  "type": "Line",
                },
                {
                  "def": {
                    "a": [
                      0,
                      0,
                    ],
                    "b": [
                      "calcs.Qe",
                      "calcs.Pe",
                    ],
                    "color": "colors.equilibriumPrice",
                    "name": "revenue",
                    "srTitle": "Total revenue",
                  },
                  "type": "Rectangle",
                },
                {
                  "def": {
                    "color": "colors.equilibriumPrice",
                    "droplines": {
                      "horizontal": "P^*",
                      "vertical": "Q^*",
                    },
                    "name": "equilibrium_revenue",
                    "srTitle": "Equilibrium",
                    "title": "equilibrium",
                    "x": "calcs.Qe",
