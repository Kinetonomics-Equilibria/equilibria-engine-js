                      "vertical": "Q^*",
                    },
                    "ghost": true,
                    "name": "equilibrium_mirror",
                    "srTitle": "Equilibrium exchange rate",
                    "title": "equilibrium",
                    "x": "calcs.Qe",
                    "y": "calcs.inverse",
                  },
                  "type": "Point",
                },
              ],
              "xAxis": {
                "intercept": 1,
                "max": 100,
                "min": 0,
                "title": "Quantity traded (AUD)",
              },
              "yAxis": {
                "max": 2.6,
                "min": 1,
                "tickPrecision": 2,
                "title": "AUD per USD",
              },
            },
          ],
        },
      },
      "params": [
        {
          "label": "Demand for AUD",
          "max": 70,
