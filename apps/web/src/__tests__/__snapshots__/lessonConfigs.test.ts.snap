                {
                  "def": {
                    "color": "colors.demand",
                    "fn1": "params.a - (x)",
                    "fn2": "calcs.Pe",
                    "max": "calcs.Qe",
                    "min": 0,
                    "name": "consumerSurplus",
                    "srTitle": "Consumer surplus",
                  },
