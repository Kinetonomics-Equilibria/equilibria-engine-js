                },
                {
                  "def": {
                    "color": "colors.equilibriumPrice",
                    "droplines": {
                      "horizontal": "P^*",
                      "vertical": "Q^*",
                    },
                    "name": "equilibrium_surplus",
                    "srTitle": "Equilibrium",
                    "title": "equilibrium",
                    "x": "calcs.Qe",
                    "y": "calcs.Pe",
                  },
                  "type": "Point",
                },
              ],
              "xAxis": {
                "max": 20,
                "min": 0,
                "title": "Quantity",
              },
              "yAxis": {
                "max": 20,
                "min": 0,
                "title": "Price (\\\\$)",
              },
            },
            {
              "key": "revenue",
              "objects": [
                {
                  "def": {
                    "color": "colors.demand",
