        },
      ],
      "schema": "EconSchema",
    },
    "directionWords": {
      "demand": {
        "down": "left",
        "up": "right",
      },
      "supply": {
        "down": "left",
        "up": "right",
      },
    },
    "explainedCalcs": {
      "Qe": "(params.demand + params.supply)/2",
      "inverse": "1/calcs.rate",
      "rate": "0.65 + (params.demand - params.supply)/200",
    },
    "explorePrompts": [
      "Make AUD 1 worth USD 0.75. Which curve did you move, and which way?",
      "Raise demand and supply by the same amount. What happens to the exchange rate?",
      "Make the AUD depreciate without touching supply.",
    ],
    "id": "aud",
    "name": "The market for the Australian dollar",
    "narratedCalcs": [
      {
        "fall": "The AUD depreciates",
        "label": "AUD 1 =",
        "meaning": "Exchange rate: the price of AUD 1 in USD",
        "name": "rate",
        "precision": 2,
        "rise": "The AUD appreciates",
        "tex": "e^*",
        "unit": "USD ",
      },
      {
        "fall": "The USD depreciates",
        "label": "USD 1 =",
        "meaning": "The price of USD 1 in AUD",
        "name": "inverse",
        "precision": 2,
        "rise": "The USD appreciates",
        "tex": "\\\\frac{1}{e^*}",
        "unit": "AUD ",
      },
      {
        "fall": "Less AUD changes hands",
        "label": "AUD traded",
        "meaning": "Quantity of AUD traded",
        "name": "Qe",
        "precision": 0,
        "rise": "More AUD changes hands",
        "tex": "Q^*",
      },
    ],
    "panels": [
      {
        "delta": "dRate",
        "headline": "rate",
        "key": "market",
        "name": "AUD market",
      },
      {
        "delta": "dInverse",
        "headline": "inverse",
        "key": "mirror",
        "name": "USD market",
      },
    ],
    "paramMeanings": {
      "demand": "AUD demanded at USD 0.65",
      "supply": "AUD supplied at USD 0.65",
    },
    "paramWords": {
      "demand": {
        "about": "People overseas paying for Australian exports, holidays and assets.",
        "curve": "demand",
        "fall": "Demand for AUD decreases",
        "rise": "Demand for AUD increases",
      },
      "supply": {
        "about": "Australians paying for imports, trips and assets overseas.",
        "curve": "supply",
        "fall": "Supply of AUD decreases",
