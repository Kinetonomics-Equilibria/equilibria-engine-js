                    "name": "supply_market",
                    "slope": 1,
                    "srTitle": "Supply",
                    "title": "supply",
                    "yIntercept": "params.c",
                  },
                  "type": "Line",
                },
                {
                  "def": {
                    "color": "colors.equilibriumPrice",
                    "droplines": {
                      "horizontal": "P^*",
                      "vertical": "Q^*",
                    },
                    "ghost": true,
                    "name": "equilibrium_market",
                    "srTitle": "Equilibrium",
                    "title": "equilibrium",
                    "x": "calcs.Qe",
                    "y": "calcs.Pe",
                  },
                  "type": "Point",
                },
              ],
              "xAxis": {
                "max": 20,
                "min": 0,
                "title": "Quantity",
              },
              "yAxis": {
                "max": 20,
                "min": 0,
                "title": "Price (\\\\$)",
              },
            },
            {
              "key": "surplus",
