      "schema": "EconSchema",
    },
    "explainedCalcs": {
      "maxC": "params.C * params.h",
      "maxT": "params.T * params.h",
      "oc": "calcs.cost / calcs.gain",
    },
    "explorePrompts": [
      "Put A and B where each extra toastie costs less than 1 coffee. Which end of the curve are they at?",
      "Drag B to the left of A. What does each extra coffee cost, in toasties?",
      "Make every toastie cost the same number of coffees, wherever A and B are.",
    ],
    "id": "cafe",
    "name": "Toasties and coffees at a café",
    "narratedCalcs": [
      {
        "fall": "Each toastie costs fewer coffees",
        "label": "Coffees per toastie",
        "meaning": "The opportunity cost of one more toastie, going from A to B",
        "name": "oc",
        "precision": 1,
        "rise": "Each toastie costs more coffees",
        "tex": "\\\\text{Opportunity cost}",
      },
      {
        "label": "Toasties gained",
        "meaning": "The extra toasties, going from A to B",
        "name": "gain",
        "precision": 0,
      },
      {
        "label": "Coffees given up",
        "meaning": "The coffees given up for them",
        "name": "cost",
        "precision": 0,
      },
      {
        "fall": "The café can make fewer coffees",
        "label": "Most coffees",
        "meaning": "The most coffees the café can make, with every hour on coffee",
        "name": "maxC",
        "precision": 0,
        "rise": "The café can make more coffees",
      },
      {
        "fall": "The café can make fewer toasties",
        "label": "Most toasties",
        "meaning": "The most toasties the café can make, with every hour on toasties",
        "name": "maxT",
        "precision": 0,
        "rise": "The café can make more toasties",
      },
    ],
    "panels": [
      {
        "delta": "dOc",
        "headline": "oc",
        "key": "cafe",
        "name": "Café",
      },
    ],
    "paramMeanings": {
      "C": "coffees an hour of work makes, when it all goes on coffee",
      "T": "toasties an hour of work makes, when it all goes on toasties",
      "h": "hours of work on the shift",
    },
    "paramWords": {
      "C": {
        "about": "How many coffees an hour of work makes, if all of it goes on coffee. Better machines and skills raise it.",
        "curve": "ppf",
        "fall": "Coffee-making gets slower",
        "rise": "Coffee-making gets faster",
      },
      "T": {
        "about": "How many toasties an hour of work makes, if all of it goes on toasties. A better sandwich press raises it.",
        "curve": "ppf",
        "fall": "Toastie-making gets slower",
        "rise": "Toastie-making gets faster",
      },
      "a": {
        "about": "Point A, on the curve. Drag it along the curve, or move it here.",
        "curve": "choice",
      },
      "b": {
        "about": "Point B, on the curve. Drag it along the curve, or move it here.",
        "curve": "choice",
      },
      "h": {
        "about": "Five staff from 7 to 11 is 20 hours. More staff or longer hours mean more resources.",
        "curve": "ppf",
        "fall": "Resources decrease",
        "rise": "Resources increase",
      },
      "k": {
        "about": "How differently suited the staff are to the two jobs. At 1 everyone is as good at one as the other, and the curve is a straight line.",
        "fall": "The staff are less specialised",
        "rise": "The staff are more specialised",
      },
      "pc": {
        "about": "Point Z can go anywhere: inside the curve, on it or outside.",
        "curve": "combination",
      },
      "pt": {
        "about": "Point Z can go anywhere: inside the curve, on it or outside.",
        "curve": "combination",
      },
    },
    "questionApparatus": {
      "C": {
        "answer": "answerC",
        "start": "startC",
      },
      "T": {
        "answer": "answerT",
        "start": "startT",
      },
      "h": {
        "answer": "answerH",
        "start": "startH",
      },
    },
    "scenarios": [
      {
        "description": "Five staff for five hours is 25 hours of work. More resources shift the whole curve outward.",
        "id": "open-early",
        "label": "Open an hour earlier",
        "params": {
          "h": 25,
        },
      },
      {
        "description": "8 hours of work gone, 12 left. Fewer resources shift the whole curve inward.",
        "id": "sick",
        "label": "Two staff call in sick",
        "params": {
          "h": 12,
        },
      },
      {
        "description": "15 coffees an hour instead of 10. The curve pivots up the coffee axis.",
        "id": "espresso",
        "label": "A faster espresso machine",
        "params": {
          "C": 15,
        },
      },
      {
        "description": "7.5 toasties an hour instead of 5. The curve pivots out along the toastie axis.",
        "id": "press",
        "label": "A bigger sandwich press",
        "params": {
          "T": 7.5,
        },
      },
      {
        "description": "Nobody has to take orders at the counter, so every hour makes more of both. The whole curve shifts outward.",
        "id": "ordering-app",
        "label": "Customers order on an app",
        "params": {
          "C": 12,
          "T": 6,
        },
      },
      {
        "description": "A straight-line PPC: every toastie costs 2 coffees, wherever the café is on it.",
        "id": "equally-good",
        "label": "Everyone equally good at both",
        "params": {
          "k": 1,
        },
      },
      {
        "id": "baseline",
        "label": "Back to a normal Saturday",
        "params": {
          "C": 10,
          "T": 5,
          "h": 20,
          "k": 2,
        },
      },
    ],
  },
  "pictures": {
    "cover": {
      "alt": "A café counter on a Saturday morning, with an espresso machine, a sandwich press, cups of coffee and toasties waiting to go out.",
      "name": "A café counter",
      "src": "/src/lessons/pictures/ppc-cover.svg",
    },
    "crew": {
      "alt": "Five staff behind a café counter, with one espresso machine, one sandwich press and a clock reading 7 to 11: everything the café has to make coffees and toasties with.",
      "name": "The café's resources",
